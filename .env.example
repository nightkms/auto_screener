# DART OpenAPI (https://opendart.fss.or.kr/)
DART_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 운영 설정
SCREENER_TOP_N=5
SCREENER_TIMEZONE=Asia/Seoul
SCREENER_CRON=0 8 * * SAT
DASHBOARD_PORT=8765
CLAUDE_SUB_MODEL=sonnet
CLAUDE_SYNTH_MODEL=opus
LOG_LEVEL=INFO

# 이벤트 재분석 감시 (event_watch)
# 최근 분석한 종목은 30일간 재분석에서 제외되는데, 그 사이 급변하면 그날 바로 다시 분석한다.
# 트리거는 당일성 지표만 쓴다. 하루 건수 상한·쿨다운은 없다.
EVENT_WATCH_ENABLED=1
EVENT_WATCH_DAYS=30          # 감시 대상 = 최근 N일 내 분석된 종목
EVENT_SURGE_PCT=15           # 당일 등락률 N%p 이상이면 재분석 (낮출수록 감지량 급증)
EVENT_PLUNGE=0               # 급락(-N%p)도 트리거로 쓸지. 기본 0=급등만 본다
EVENT_HIGH52=1               # 52주 신고가 경신도 트리거로 사용

# TradingAgents 구성요소 (토큰이 빠듯하면 줄이거나 끈다)
DEBATE_ROUNDS=2              # 강세/약세 연구원 토론 라운드 (라운드당 Sonnet 2회, 0=생략)
TRADING_ENABLED=1            # 트레이더 → 리스크 토론 → 포트폴리오 매니저 최종 BUY/HOLD/SELL
RISK_DEBATE_ROUNDS=1         # 리스크 토론(공격·보수·중립) 라운드 (라운드당 Sonnet 3회)
RETROSPECT_ENABLED=1         # 주말(토·일) 1회 회고: 등급 vs 이후 수익률 → 역할별 교훈을 쌓아 다음 분석에 주입

# 분석 연속 실패 알림 (queue_worker)
# Claude Code가 주기적으로 요구하는 재로그인은 토큰 만료 점검에 안 걸리고 서브에이전트만
# 전부 실패시킨다 → 사람이 /login 하기 전엔 자동 복구가 없다. 그래서 원인과 무관하게
# '연속 N건 + M시간 지속'이면 텔레그램으로 알린다(둘 다 만족해야 발송).
FAIL_ALERT_COUNT=3           # 연속 실패 N건 이상
FAIL_ALERT_HOURS=3           # 그리고 최초 실패 후 N시간 이상 지속
FAIL_ALERT_REPEAT_H=6        # 지속되는 동안 재알림 간격(시간)
FAIL_ALERT_STALE_H=6         # 실패가 N시간 넘게 없으면 스트릭을 새로 시작

# Claude Code SDK 설정 디렉토리 격리.
# 미설정 시 프로젝트 안 .claude_config/ 로 자동 격리(권장) → 홈 ~/.claude.json 동시
# write 경합 방지(대화형 Claude Code 세션을 같은 머신에서 병행해도 충돌 차단).
# 첫 실행 시 홈 로그인을 자동 승계하므로 재로그인 불필요.
# 격리를 끄고 홈 config를 그대로 쓰려면: SCREENER_CLAUDE_CONFIG_DIR=off
# 다른 경로로 격리하려면 그 경로를 지정.
#SCREENER_CLAUDE_CONFIG_DIR=off

# Claude 장기 OAuth 토큰(권장). 별도 터미널에서 `claude setup-token` 실행 → 출력된
# sk-ant-oat01-... 를 넣는다(약 1년 유효, Max 구독 한도에서 차감 — API 과금 아님).
# 설정 시 홈 토큰 재시드·keepalive·만료 점검을 건너뛴다. 만료(1년) 시 재발급.
# 주의: ANTHROPIC_API_KEY가 env에 있으면 API 과금으로 새므로 config가 자동 제거한다.
#CLAUDE_CODE_OAUTH_TOKEN=
